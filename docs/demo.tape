# Re-record with: make demo
Output docs/demo.gif

Set Shell bash
Set FontSize 18
Set Width 1400
Set Height 640
Set Padding 24
Set TypingSpeed 45ms
Set Theme "Catppuccin Mocha"

Hide
Type "source docs/demo-setup.sh && clear"
Enter
Show

Type "aaa add retry to the upload job"
Sleep 400ms
Enter
Sleep 1.5s

Type "aaa"
Sleep 400ms
Enter
Sleep 4s

Type "aaa --close k7f"
Sleep 400ms
Enter
Sleep 1.5s

Type "aaa"
Sleep 400ms
Enter
Sleep 5s
